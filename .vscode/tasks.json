{
    "version": "2.0.0",
    "tasks": [
                {
            "label": "rust: build",
            "type": "cargo",
            "command": "build",
            "args": [
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build",
        },
        {
            "label": "rust: pdf-engine",
            "dependsOn": "core: build",
            "type": "cargo",
            "command": "build",
            "args": [
                "-p",
                "pdf-engine"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build",
        },
        {
            "label": "rust: pdfinfo-gtk",
            "type": "cargo",
            "command": "build",
            "args": [
                "-p",
                "pdfinfo-gtk"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build",
            "env": {
                // See https://developer.gnome.org/documentation/tools/inspector.html
                "GTK_DEBUG": "interactive",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]
}
