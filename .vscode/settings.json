{
    "explorer.excludeGitIgnore": false,
    "search.exclude": {
        "extern": true
    },
    "VsCodeTaskButtons.tasks": [
        {
            "label": "rust: pdfinfo-gtk",
            "task": "rust: pdfinfo-gtk"
        },
        {
            "label": "rust: pdf-engine",
            "task": "rust: pdf-engine"
        },
        {
            "label": "cmake: pdf-engine-core",
            "task": "cmake: pdf-engine-core"
        }
    ],
    // Rust
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true,
        "editor.wordWrapColumn": 100,
        "rewrap.wrappingColumn": 100,
    },
   "rust-analyzer.rustfmt.extraArgs": ["+nightly"],
   "rust-analyzer.check.command": "clippy",
    // Python
    "python.analysis.typeCheckingMode": "standard",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
        }
    },
    // C/C++
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.formatting": "clangFormat",
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
    },
    // License
    "licenser.license": "MIT",
    "licenser.author": "Philip B. (philipbel)",
    "licenser.projectName": "PDF Info",
    // Spelling
    "cSpell.words": [
        "accels",
        "adwaita",
        "bindgen",
        "bindtextdomain",
        "clippy",
        "cmap",
        "codeset",
        "concatcp",
        "Crossfade",
        "endforeach",
        "endfunction",
        "fitz",
        "fontconfig",
        "Fontconfig",
        "fontfile",
        "fontname",
        "fontsize",
        "formatx",
        "freetype",
        "gettextrs",
        "github",
        "gnumake",
        "graphene",
        "Graphene",
        "gresource",
        "gschema",
        "GTRUE",
        "halign",
        "harfbuzz",
        "langinfo",
        "libadwaita",
        "libclang",
        "libfile",
        "libjpeg",
        "libqpdf",
        "libz",
        "lipo",
        "MSVC",
        "nullable",
        "pango",
        "pdfinfo",
        "pdfs",
        "philipbel",
        "pixbuf",
        "pkgs",
        "qpdf",
        "rustup",
        "setlocale",
        "SOVERSION",
        "strdup",
        "venv",
        "vexpand",
        "vhomogeneous",
        "winget",
        "xalign"
    ],
    "rust-analyzer.checkOnSave": true,
}
